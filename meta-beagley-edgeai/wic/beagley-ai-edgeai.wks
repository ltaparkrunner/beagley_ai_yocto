# short-description: Create SD card image with 2 partitions and EdgeAI DTB support

bootloader --timeout=3 --append="rootfstype=ext4 "
part --source bootimg-efi --sourceparams="loader=grub-efi,configfile=beagley-ai-grub.cfg" --fstype=vfat --label boot --active --align 1024 --use-uuid --fixed-size 128M
part / --source rootfs --fstype=ext4 --label root --align 1024 --use-uuid
